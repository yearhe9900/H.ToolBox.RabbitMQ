<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- 集成测试依赖 Docker。默认启用；无 Docker 环境的机器可用 -p:EnableIntegrationTests=false 完整关闭，
       关闭时 Integration 目录不参与编译，也不会还原 Testcontainers 包。 -->
  <PropertyGroup>
    <EnableIntegrationTests Condition="'$(EnableIntegrationTests)' == ''">true</EnableIntegrationTests>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\H.ToolBox.RabbitMQ\H.ToolBox.RabbitMQ.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableIntegrationTests)' == 'true'">
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableIntegrationTests)' != 'true'">
    <Compile Remove="Integration/**/*.cs" />
  </ItemGroup>

</Project>
